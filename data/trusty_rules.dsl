  [rule: Verb_3rd_Person]
- she + fly | flies, flys
  [rule: Verb_3rd_Person]
- it + watch | watches, watchs
  [rule: Verb_3rd_Person]
- he + say | says, saies
  [rule: Verb_3rd_Person]
- she + go | goes, gos
  [rule: Verb_3rd_Person]
- it + finish | finishes, finishs
  [rule: Verb_3rd_Person]
- he + play | plays, plaies
  [rule: Verb_3rd_Person]
- she + kiss | kisses, kisss
  [rule: Verb_3rd_Person]
- it + fix | fixes, fixs
  [rule: Verb_3rd_Person]
- he + buy | buys, buies
